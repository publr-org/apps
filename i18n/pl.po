msgid "Not on this Mac"
msgstr "Nie ma na tym Macu"

msgid "On this Mac, not connected"
msgstr "Na tym Macu, niepodłączone"

msgid "Connecting…"
msgstr "Łączenie…"

msgid "In Cursor, choose Install"
msgstr "W Cursorze wybierz Install"

msgid "Connected"
msgstr "Podłączone"

msgid "Couldn’t connect. Try again."
msgstr "Nie udało się podłączyć. Spróbuj ponownie."

msgid "Connect"
msgstr "Podłącz"

msgid "Open Cursor again"
msgstr "Otwórz Cursora ponownie"

msgid "Publr Cloud could not be reached."
msgstr "Nie udało się połączyć z Publr Cloud."

msgid "Publr Cloud did not make the project."
msgstr "Publr Cloud nie utworzył projektu."

msgid "Publr Cloud did not sign you in to the project."
msgstr "Publr Cloud nie zalogował cię do projektu."

msgid "Publr Cloud did not list your sites."
msgstr "Publr Cloud nie pokazał twoich projektów."

msgid "Publr Cloud answered something Desktop does not understand."
msgstr "Publr Cloud odpowiedział czymś, czego Desktop nie rozumie."

msgid "Sign-in was denied. Try again, or use Publr without Cloud."
msgstr "Logowanie odrzucone. Spróbuj ponownie albo używaj Publr bez Cloud."

msgid "Sign-in took too long. Try again."
msgstr "Logowanie trwało zbyt długo. Spróbuj ponownie."

msgid "Signing in to Publr Cloud did not work."
msgstr "Nie udało się zalogować do Publr Cloud."

msgid "Signed in to Publr Desktop"
msgstr "Zalogowano w Publr Desktop"

msgid "You can close this tab and go back to Desktop."
msgstr "Możesz zamknąć tę kartę i wrócić do Desktop."

msgid "Sign-in denied"
msgstr "Logowanie odrzucone"

msgid "Publr Desktop is still signed out. You can close this tab."
msgstr "Publr Desktop nadal jest wylogowany. Możesz zamknąć tę kartę."

msgid "Desktop ran out of memory."
msgstr "Desktopowi zabrakło pamięci."

msgid "The site could not be deployed."
msgstr "Nie udało się wdrożyć projektu."

msgid "That address was just taken. Pick another."
msgstr "Ten adres właśnie został zajęty. Wybierz inny."

msgid "That address cannot be used. Pick another."
msgstr "Tego adresu nie można użyć. Wybierz inny."

msgid "That space is not yours any more."
msgstr "Ta przestrzeń nie jest już twoja."

msgid "The upload was lost. Try again."
msgstr "Wysyłanie zostało przerwane. Spróbuj ponownie."

msgid "Publr Cloud could not read the packed site."
msgstr "Publr Cloud nie odczytał spakowanego projektu."

msgid "This site was made by a newer Publr than Publr Cloud runs."
msgstr "Ten projekt powstał w nowszym Publr niż ten, na którym działa Publr Cloud."

msgid "Verify your email address first (Publr Cloud sent you a link)."
msgstr "Najpierw potwierdź adres e-mail (Publr Cloud wysłał ci link)."

msgid "Publr Cloud cannot start sites right now. Try again in a moment."
msgstr "Publr Cloud nie może teraz uruchamiać projektów. Spróbuj za chwilę."

